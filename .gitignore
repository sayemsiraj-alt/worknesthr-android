# Dependencies
node_modules/

# Production web build (generated by `vite build`; regenerated in CI)
dist/
dist-ssr/

# Local environment files — never commit real credentials
.env
.env.local
.env.*.local

# Firebase / Google service credentials. The app uses the Firebase Web SDK with a
# public client config, so these files are not required to build the APK. They are
# ignored defensively so a service-account key can never be committed by accident.
google-services.json
serviceAccountKey.json
*service-account*.json

# Android signing material — must only ever live in CI secrets
*.jks
*.keystore
keystore.properties

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
